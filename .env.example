BOT_TOKEN=replace_with_new_token
# Пусто = доступ открыт всем. Иначе укажите положительные Telegram ID через запятую.
ALLOWED_USER_IDS=
# Защищённые главные администраторы. Их роль нельзя изменить внутри Telegram.
ADMIN_USER_IDS=
TIMEZONE=Europe/Berlin
DATABASE_URL=sqlite+aiosqlite:///data/bot.db
LOG_LEVEL=INFO
# Прокси и VPN НЕ нужны. Бот подключается к Telegram напрямую.
# Пустое значение — прямой режим, который и используется по умолчанию.
# Строку можно удалить или оставить пустой: это одно и то же.
TELEGRAM_PROXY=
# Что пробовать первым: direct — прямое подключение (по умолчанию),
# proxy — сначала резервный прокси, затем прямое подключение.
TELEGRAM_PREFER=direct
FORCE_IPV4=true
TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe

# --- Резервные копии ---------------------------------------------------------
# Папка для копий базы. Должна быть доступна боту на запись.
BACKUP_DIR=data/backups

# --- Архив в Telegram-канале -------------------------------------------------
# Канал, куда бот сразу дублирует каждую карточку (фото + VIN) и раз в сутки
# присылает файл базы. Формат: @имя_канала или -1001234567890.
# Бота нужно добавить в канал администратором с правом публикации сообщений.
# Пусто = архив отключён.
ARCHIVE_CHANNEL_ID=
# Дублировать карточку сразу после создания (true) — рекомендуется.
ARCHIVE_IMMEDIATE=true
# Во сколько по местному времени отправлять файл базы (ЧЧ:ММ).
ARCHIVE_DIGEST_TIME=23:30
# Класть ли в архив фото накладной вместе с фото автомобиля.
ARCHIVE_INCLUDE_INVOICE=true
# Язык подписей в канале: ru или de.
ARCHIVE_LANGUAGE=ru

# --- Второй читатель (необязательно) ---------------------------------------
# Бот сам читает VIN с фотографии: без интернета и без оплаты.
# Ключ Google Gemini подключает второго читателя для трудных снимков —
# блики, размытие, VIN на стекле. Без ключа бот работает как раньше.
# Ключ берут на aistudio.google.com («Get API key»), он выглядит как AIza…
# Пусто = второй читатель выключен, бот читает только сам.
GEMINI_API_KEY=
# Когда спрашивать облако:
#   auto   — только если бот сам прочитал неуверенно (рекомендуется);
#   first  — облако читает ПЕРВЫМ, бот — запасной путь. На трудных снимках
#            быстрее: картинка не читается дважды;
#   always — проверять каждую фотографию, но уверенное чтение бота не менять;
#   off    — никогда не спрашивать.
GEMINI_MODE=auto
# Какую модель спрашивать. Имена моделей Google меняет и старые отключает
# (например, gemini-2.0-flash отключили 1 июня 2026 года). Если указанная
# модель окажется отключена, бот спросит у API, какие модели доступны этому
# ключу, и продолжит на одной из них — но лучше держать здесь актуальное имя.
#
# Значение по умолчанию — gemini-3.5-flash-lite: на настоящем снимке она
# прочитала VIN верно (уверенность 0,95), тогда как gemini-3.8-flash на том же
# снимке потратила вывод на рассуждения и оборвала ответ. Запрещённые имена
# (gemini-3.6-flash, gemini-3.8-flash) бот игнорирует, даже если они записаны
# здесь, и берёт модель по умолчанию.
GEMINI_MODEL=gemini-3.5-flash-lite
# Сколько секунд ждать ответа облака, прежде чем читать снимок самому.
GEMINI_TIMEOUT=45
# Откуда уходит запрос в облако. Обычно строка не нужна: запрос идёт напрямую.
# Она нужна там, где сервис отказывает вызывающему по стране — Google отвечает
# «User location is not supported for the API use». Укажите здесь локальный
# прокси, и ошибка уйдёт: запрос выйдет с адреса прокси.
#   GEMINI_PROXY=http://127.0.0.1:10809
# Через прокси идёт ТОЛЬКО запрос в облако. Телеграм ходит своей дорогой,
# поэтому прокси, который перестанет работать, погасит второго читателя —
# и больше ничего: бот останется на связи и будет читать снимки сам.
GEMINI_PROXY=
